      "boss_disposition": "slayer",
      "reliable": true,
      "layer": "l1",
      "floor": 1,
      "room_type": "boss",
      "priority": 8,
      "weight": 1.0,
      "tags": ["boss_result", "slay", "ash"]
    },
    {
      "text_id": "boss_2_slay",
      "text": "공허가 채워진다... 아니, 공허 자체가 사라진다.",
