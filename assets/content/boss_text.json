      "boss_disposition": "none",
      "reliable": true,
      "layer": "l1",
      "floor": 5,
      "room_type": "boss",
      "priority": 10,
      "weight": 1.0,
      "tags": ["boss_intro", "root"]
    },
    {
      "text_id": "boss_1_slay",
      "text": "재가 흩어진다... 실패한 구원자는 마침내 쉴 수 있다.",
